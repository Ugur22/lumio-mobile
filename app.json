{
  "expo": {
    "name": "Lumio",
    "slug": "lumio",
    "scheme": "lumio",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.ugur22.lumio"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#235242",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.ugur22.lumio"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 140,
          "backgroundColor": "#f7f2e9",
          "dark": { "image": "./assets/splash-icon.png", "backgroundColor": "#1b1814" }
        }
      ],
      "expo-secure-store",
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "Lumio uses your photo library so you can attach pictures to a message.",
          "cameraPermission": "Lumio uses the camera so you can take a picture to attach to a message."
        }
      ],
      "expo-web-browser"
    ]
  }
}
